# 复制为 .env 后填入真实值

# ---------------- 模型 ----------------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# 主模型 / 备用模型（langchain 的 "provider:model" 写法）
AGENT_MODEL=deepseek:deepseek-flash
FALLBACK_MODEL=deepseek:deepseek-chat   # 主模型重试仍失败时自动降级到它
AGENT_FALLBACK_ENABLED=true
AGENT_MODEL_TEMPERATURE=0.3
AGENT_MODEL_TIMEOUT=60       # 单次模型请求超时（秒）
AGENT_MODEL_MAX_TOKENS=2048  # 单次输出上限，挡住天价账单

# 模型是否支持图片输入；false 时图片只传文件名给模型（不报错）
MODEL_VISION=true

# ---------------- 数据库 ----------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=python
DB_CONNECT_TIMEOUT=5   # 连不上就尽快失败，别把请求线程挂死
DB_READ_TIMEOUT=15
DB_WRITE_TIMEOUT=15

# ---------------- 服务 ----------------
PORT=5000
APP_ENV=dev              # dev / prod；prod 会自动关掉 debug、日志降到 INFO
APP_DEBUG=true           # 不填时：dev=true，prod=false
HOST=0.0.0.0
LOG_LEVEL=DEBUG          # DEBUG / INFO / WARNING / ERROR
LOG_FORMAT=text          # text=本地好读；json=一行一条，交给采集器
SSE_HEARTBEAT_SECONDS=15 # 对话空闲超过这么久就发心跳，防止代理掐断长连接

# ---------------- 跨域 ----------------
CORS_ORIGINS=*           # 生产请写白名单，例如 https://app.example.com,https://admin.example.com
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=600         # 预检结果缓存秒数

# ---------------- 限流 / 压缩 ----------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MIN=120
RATE_LIMIT_SSE_PER_MIN=20
RATE_LIMIT_UPLOAD_PER_MIN=30
GZIP_ENABLED=true
GZIP_MIN_BYTES=512

# ---------------- Agent 中间件 ----------------
# 下面这些阈值故意取小值：demo 聊几轮就能触发摘要、上下文清理与限额保护，
# 方便验证中间件确实在干活。上线时按注释里的量级放大。
AGENT_SUMMARY_ENABLED=true
AGENT_SUMMARY_TRIGGER_TOKENS=1500     # 生产建议：模型上下文窗口的 60~80%
AGENT_SUMMARY_TRIGGER_MESSAGES=8
AGENT_SUMMARY_KEEP_MESSAGES=4
AGENT_SUMMARY_TRIM_TOKENS=2000

AGENT_CONTEXT_EDITING_ENABLED=true
AGENT_CONTEXT_CLEAR_TRIGGER_TOKENS=2500
AGENT_CONTEXT_CLEAR_KEEP=2

AGENT_MODEL_RUN_LIMIT=6         # 单轮对话最多调用几次模型
AGENT_MODEL_THREAD_LIMIT=20     # 同一会话累计上限
AGENT_TOOL_RUN_LIMIT=8          # 单轮最多几次工具调用（防 Agent 原地打转）
AGENT_TOOL_THREAD_LIMIT=30

AGENT_MODEL_MAX_RETRIES=2       # 模型调用失败重试次数
AGENT_TOOL_MAX_RETRIES=2        # 工具执行失败重试次数
AGENT_RETRY_INITIAL_DELAY=0.5   # 指数退避起始秒数
AGENT_RETRY_MAX_DELAY=8
AGENT_RETRY_BACKOFF_FACTOR=2

AGENT_PII_ENABLED=true          # 输入侧脱敏（邮箱/银行卡/身份证/手机号/API Key）
AGENT_INPUT_GUARD_ENABLED=true
AGENT_MAX_INPUT_CHARS=20000     # 单条用户消息字符上限
AGENT_TOOL_SELECTOR_ENABLED=false  # 工具很多时才开，代价是每次多一次模型调用
AGENT_TOOL_SELECTOR_MAX_TOOLS=6

# ---------------- 附件 ----------------
UPLOAD_DIR=                # 留空 = 项目下 ./uploads
MAX_UPLOAD_MB=20           # 单个文件大小上限
MAX_IMAGE_MB=8             # 图片原始大小上限
MAX_ATTACHMENT_TEXT=8000   # 单个附件注入模型的文本上限（字符）
MAX_ATTACHMENT_TEXT_TOTAL=30000  # 单条消息里所有附件注入文本的总上限
MAX_SHEET_ROWS=200         # 表格类附件最多解析行数
MAX_SHEET_COLS=30          # 表格类附件最多解析列数
IMAGE_KEEP_TURNS=2         # 历史里保留图片块的最近轮数（越大越费 token）
IMAGE_MAX_EDGE=1600        # 图片压缩后的最长边像素
